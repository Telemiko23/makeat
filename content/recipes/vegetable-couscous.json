  "steps": [
    {
      "text": {
        "he": "חותכים את כל הירקות לקוביות גדולות."
      },
      "minutes": 15
    },
    {
      "text": {
        "he": "בסיר גדול מאדים את הבצל בשמן, מוסיפים רסק, כורכום וקינמון ומערבבים."

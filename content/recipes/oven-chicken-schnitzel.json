  "steps": [
    {
      "text": {
        "he": "מחממים תנור ל-220 מעלות ומרפדים תבנית בנייר אפייה."
      }
    },
    {
      "text": {
        "he": "פורסים את החזה לפרוסות דקות בעובי אחיד."
      }
    },
    {
      "text": {
        "he": "טורפים ביצים עם מלח ופלפל בצלחת אחת, ומערבבים פירורי לחם עם פפריקה ושמן בצלחת שנייה."
      }
    },
    {
      "text": {
        "he": "טובלים כל פרוסה בביצה ואחר כך בפירורים, ולוחצים שיידבקו."
      },
      "minutes": 10
    },
    {
      "text": {
        "he": "מסדרים בתבנית ואופים, הופכים באמצע, עד שהשניצלים זהובים."
      },
      "minutes": 20
    },
    {
      "text": {
        "he": "מגישים עם פלחי לימון."
      }
    }
  ]

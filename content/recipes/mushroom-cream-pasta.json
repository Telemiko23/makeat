  "steps": [
    {
      "text": {
        "he": "מבשלים את הפסטה במים רותחים עם מלח, ושומרים כוס ממי הבישול."
      }
    },
    {
      "text": {
        "he": "ממיסים חמאה במחבת רחבה ומשחימים את הפטריות הפרוסות על אש גבוהה, בלי לערבב יותר מדי."
      },
      "minutes": 7
    },
    {
      "text": {
        "he": "מוסיפים בצל ושום קצוצים ומטגנים עד שהם מתרככים."
      },
      "minutes": 3
    },
    {
      "text": {
        "he": "מוסיפים שמנת, מלח ופלפל ומבשלים עד שהרוטב מסמיך מעט."
      },
      "minutes": 4
    },
    {
      "text": {
        "he": "מוסיפים את הפסטה ומעט ממי הבישול עד שהרוטב מבריק. מגישים עם גבינה מגוררת."
      }
    }
  ]

  "steps": [
    {
      "text": {
        "he": "חותכים את הבצל והפלפל לרצועות דקות, ופורסים את השום."
      }
    },
    {
      "text": {
        "he": "מחממים שמן במחבת רחבה ומטגנים את הבצל והפלפל על אש בינונית עד שהם מתרככים."
      },
      "minutes": 8
    },
    {
      "text": {
        "he": "מוסיפים שום, פפריקה וכמון ומערבבים דקה עד שעולה ריח."
      },
      "minutes": 1
    },
    {
      "text": {
        "he": "מוסיפים עגבניות קצוצות, רסק ומלח. מבשלים עד שהרוטב מסמיך."
      },
      "minutes": 10
    },
    {
      "text": {
        "he": "עושים גומות ברוטב, שוברים לתוכן את הביצים, מכסים ומבשלים על אש נמוכה עד שהחלבון מתייצב."
      },
      "minutes": 6
    },
    {
      "text": {
        "he": "מפזרים פטרוזיליה קצוצה ומגישים מהמחבת."
      }
    }
  ]
}